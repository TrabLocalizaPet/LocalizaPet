# Copie para .env e preencha. O .env nunca entra no Git.
# O repositorio e publico: credencial commitada e credencial vazada.
#
# Este arquivo descreve o ambiente de DESENVOLVIMENTO. As credenciais de
# producao vivem so no painel da Vercel, no escopo Production, e nao passam
# por aqui. Ver DT-06.

# Supabase -> projeto de DESENVOLVIMENTO (nao o de producao)
#          -> Project Settings -> Database -> Connection string
# Use a string do POOLER, porta 6543. A direta (5432) funciona em
# desenvolvimento e derruba conexoes sob carga. Ver DT-02.
DATABASE_URL=

# Cloudflare -> R2 -> Manage API tokens
# O bucket aqui e o localizapet-dev. O local usa bucket separado, nao usa
# disco: gravar em disco nao existe em funcao serverless e esconderia o erro
# de CORS ate o deploy. Ver DT-06.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# URL publica do bucket (dominio r2.dev ou dominio proprio), sem barra no fim
R2_PUBLIC_URL=
